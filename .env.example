# --- Supabase (proposal storage) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Next.js browser client (publishable key only; never put the service key here) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- SMTP (myGov/GAA Tuesday & Thursday alert) ---
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Nairobi-time start for the Tuesday/Thursday myGov alert check
MYGOV_ALERT_HOUR=9
MYGOV_ALERT_MINUTE=0

# Respectful public-web fetching: wait at least this long between requests to one site.
# Do not use this to bypass CAPTCHAs, logins, rate limits, or other access controls.
SCRAPER_REQUEST_INTERVAL_SECONDS=1.5
SCRAPER_USER_AGENT=ProposalMonitor/1.0 (+contact your technical owner)

# Content approval and n8n handoff
CONTENT_PUBLISH_WEBHOOK_URL=http://n8n:5678/webhook/content-approved
CONTENT_DISPATCH_INTERVAL_SECONDS=60

# AI proposal research agent (leave values blank here; put rotated keys only in .env)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
FIRECRAWL_API_KEY=
URL_LIMIT=3
BATCH_LIMIT=2
AI_CLASSIFICATION_LIMIT=30
GEMINI_BATCH_SIZE=10
LANGSMITH_PROJECT=scrapping-agent
LANGSMITH_API_KEY=
LANGSMITH_TRACING_V2=true
